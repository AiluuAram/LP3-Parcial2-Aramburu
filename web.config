<?xml version="1.0"?>
<configuration>
  <appSettings>
    <!-- Necesario para que los controles de validación funcionen sin jQuery -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <!-- maxRequestLength en KB: 10 MB como tope de subida -->
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" />
    <sessionState timeout="30" />
    <!-- Los archivos están guardados en UTF-8 (tildes y ñ) -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Las cookies no se pueden leer desde JavaScript -->
    <httpCookies httpOnlyCookies="true" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- en bytes: 10 MB -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
